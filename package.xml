<quiqqer>
    <package>
        <title>
            <locale group="quiqqer/authfacebook" var="package.title"/>
        </title>

        <description>
            <locale group="quiqqer/authfacebook" var="package.description"/>
        </description>

        <capabilities schemaVersion="1">
            <capability id="authentication.facebook-sign-in">
                <title>Facebook sign-in</title>
                <description>
                    Provides user sign-in through Facebook accounts with secure token validation and account linking.
                </description>
            </capability>
            <capability id="identity.facebook-registration">
                <title>Facebook registration</title>
                <description>
                    Provides frontend user registration through Facebook accounts with profile data transfer and
                    configurable account activation.
                </description>
            </capability>
        </capabilities>

        <image src="URL_OPT_DIR/quiqqer/authfacebook/bin/images/Logo.jpg"/>

        <preview>
            <image src="URL_OPT_DIR/quiqqer/authfacebook/bin/images/preview/Frontend_Registration.png"/>
            <image src="URL_OPT_DIR/quiqqer/authfacebook/bin/images/preview/Backend_Settings.png"/>
        </preview>

        <support>
            <email><![CDATA[support@pcsg.de]]></email>
            <forum><![CDATA[https://community.quiqqer.com]]></forum>
            <source><![CDATA[https://dev.quiqqer.com/quiqqer/authfacebook]]></source>
            <issues><![CDATA[https://dev.quiqqer.com/quiqqer/authfacebook/issues]]></issues>
            <wiki><![CDATA[https://dev.quiqqer.com/quiqqer/authfacebook/wikis/home]]></wiki>
        </support>

        <copyright>
            <name><![CDATA[PCSG - Computer & Internet Service OHG]]></name>
            <license><![CDATA[GPL-3.0-or-later]]></license>
        </copyright>

        <provider>
            <auth src="\QUI\Auth\Facebook\Auth"/>
            <registrar src="\QUI\Registration\Facebook\Registrar"/>
            <cookie src="\QUI\Auth\Facebook\CookieProvider"/>
        </provider>

    </package>
</quiqqer>
